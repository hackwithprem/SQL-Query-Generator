# LLM Provider Configuration
# Supported providers: groq, gemini, mock (fallback when no API key provided)
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Optional alternative: Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Database Configuration (Defaults to SQLite sample database)
DATABASE_URL=sqlite:///./data/sample.db

# Security & Execution Limits
APP_ENV=development
MAX_RESULT_ROWS=500
QUERY_TIMEOUT_SECONDS=10
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
